{
    id: "futureboard-lite_sugarASR",
    name: "$$sugarASR",
    color1: "#30caf9",
    color2: "#1cb1e5",
    color3: "#2daae0",
    image: "_img/asr.png",
    description: "$$ASR_description",
    tutorial_url: "https://www.yuque.com/kittenbot/hardwares/sugar-asr",
    tags: ['module'],
    libs:{
        "asr": {
            import: 'from sugar_asr import *'
        },
    },

    blocks: 
    [
        {
            opcode: 'runInit',
            blockType: "command",
            text: "$$sugarASR_runInit",
            micropy: {
                import: "from sugar_asr import SugarASR"
            },
            pycode: "asr = SugarASR([UARTPOART])",
            arguments:{
                UARTPOART:{
                    type: "string",
                    defaultValue: 'uart0', 
                    menu: 'uartPort'
                },
            }
        },
        '---',
        //-------------------------------------------
        { 
            opcode: 'isAudioFired', 
            blockType: 'Boolean',
            pycode: 'asr.detected()', 
            text: "$$sugarASR_isAudioFired"
        },
        //-------------------------------------------
        { 
            opcode: 'isAudioAwake', 
            blockType: 'Boolean',
            pycode: "asr.cmd == '100'", 
            text: "$$sugarASR_isAudioAwake"
        },
        //-------------------------------------------
        { 
            opcode: 'isLEDWord', 
            blockType: 'Boolean',
            pycode: "asr.cmd == '[LEDWORD]'", 
            arguments:{
                LEDWORD:{
                    type:"number",
                    defaultValue: '200', 
                    menu: 'led'
                },
            },
            text: "$$sugarASR_isLEDWord"
        },
        //-------------------------------------------
        { 
            opcode: 'isExecutorWord', 
            blockType: 'Boolean',
            text: "$$sugarASR_isExecutorWord",
            pycode: "asr.cmd == '[EXECUTORWORD]'", 
            arguments:{
                EXECUTORWORD:{
                    type:"number",
                    defaultValue: '300', 
                    menu: 'executor'
                },
            },
        },
        //-------------------------------------------
        { 
            opcode: 'isQueryWord', 
            blockType: 'Boolean',
            text: "$$sugarASR_isQueryWord",
            pycode: "asr.cmd == '[QUERYWORD]'", 
            arguments:{
                QUERYWORD:{
                    type:"number",
                    defaultValue: '400', 
                    menu: 'query'
                },
            },
        },
        //-------------------------------------------
        { 
            opcode: 'isCustomizeWord', 
            blockType: 'Boolean',
            text: "$$sugarASR_isCustomizeWord",
            pycode: "asr.cmd == '[CUSTOMIZE]'", 
            arguments:{
                CUSTOMIZE:{
                    type:"number",
                    defaultValue: '901', 
                    menu: 'customize'
                },
            },
        },
        //-------------------------------------------
        { 
            opcode: 'isCammand', 
            blockType: 'Boolean',
            pycode: "asr.cmd == [CAMMAND]", 
            arguments:{
                CAMMAND:{
                    type: "string",
                    defaultValue: '910', 
                },
            },
            text: "$$ASR_isCammand"
        },
        //-------------------------------------------
        '---',
        { 
            opcode: 'runAudioWord', 
            blockType: "command",
            text: "$$sugarASR_runAudioWord",
            pycode: "asr.tts_words([KEYWORD])", 
            arguments:{
                KEYWORD:{
                    type:"number",
                    defaultValue: '1', 
                    menu: 'keyword'
                },
            },
        },
        //-------------------------------------------
        { 
            opcode: 'runInt', 
            blockType: "command",
            text: "$$sugarASR_runInt",
            pycode: "asr.tts_int([INT])", 
            arguments:{
                INT:{
                    type:"number",
                    defaultValue: 1,
                },
            },
        },
        //-------------------------------------------
        { 
            opcode: 'runDouble', 
            blockType: "command",
            text: "$$sugarASR_runDouble",
            pycode: "asr.tts_double([DOUBLE])", 
            arguments:{
                DOUBLE:{
                    type:"number",
                    defaultValue: '1.23', 
                    type: "number"
                },
            },

        },
        //-------------------------------------------
        { 
            opcode: 'runDate', 
            blockType: "command",
            pycode: "asr.tts_date([Y], [M], [D])", 
            arguments:{
                Y:{
                    type:"number",
                    defaultValue: '2016', 
                    type: "number"                       
                },
                M:{
                    type:"number",
                    defaultValue: '1', 
                    type: "number"
                },
                D:{
                    type:"number",
                    defaultValue: '6', 
                    type: "number"
                },
            },
            text: "$$sugarASR_runDate"
        },
        { 
            opcode: 'runHour', 
            blockType: "command",
            text: "$$sugarASR_runHour",
            pycode: "asr.tts_clock([H], [MIN])", 
            arguments:{
                H:{
                    type:"number",
                    defaultValue: '0', 
                    type: "number"
                },
                MIN:{
                    type:"number",
                    defaultValue: '0', 
                    type: "number"
                },
            },
        },
        '---',
    ],
    menus:{
