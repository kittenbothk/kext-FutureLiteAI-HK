        "## $$koi2_title_CustomModel",
        {
            opcode: 'koiv3CustomModelInitSD',
            blockType: "command",
            text: "$$koi2_CustomModelInitSD",
            pycode: "koi.initCustomModel([ADDR],[ANCHOR])",
            arguments:{
                ADDR:{
                    type: "string",
                    defaultValue: '/sd/ballRGB.kmodel',
                },
                ANCHOR:{
                    type: "value",
