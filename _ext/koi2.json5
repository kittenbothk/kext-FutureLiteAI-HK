        "---",  
        "## $$koi2_title_FaceAttr",
        {
            opcode: 'koiv3FaceAttrMainCoord',
            blockType: "reporter",
            text: "$$koi2_FaceAttrMainCoord",
            pycode: "koi.xywh[[COORD]]",
            arguments:{
                COORD:{
                    type: "number",
                    defaultValue: 0,
                    menu: 'coord'
                },
            }
        },
        {
            opcode: 'koiv3FaceAttrNumber',
            blockType: "reporter",
            text: "$$koi2_FaceAttrNumber",
            pycode: "int(koi.getFaceAttr([TYPE]))",
            arguments:{
                TYPE:{
                    type: "number",
                    defaultValue: 8,
                    menu: 'faceAttrQuantity'
                },
            }
        },
        {
            opcode: 'koiv3FaceAttrMain',
            blockType: "Boolean",
            text: "$$koi2_FaceAttrMain",
            pycode: "int(koi.getFaceAttr([TYPE]))",
            arguments:{
                TYPE:{
                    type: "number",
                    defaultValue: 6,
                    menu: 'faceAttrMan'
                },
            }
        },
        "---",  
        "## $$koi2_title_faceMask",
        {
            opcode: 'koiv3FaceMaskCoord',
            blockType: "reporter",
            text: "$$koi2_FaceMaskCoord",
            pycode: "koi.xywh[[XYWH]]",
            arguments:{
                XYWH:{
                    type: "number",
                    defaultValue: 0, 
                    menu: 'coord'
                },
            }
        },
        {
            opcode: 'koiv3FaceMaskState',
            blockType: "Boolean",
            text: "$$koi2_FaceMaskState",
            pycode: "koi.strVal == 'with-mask'",
        },
        "---",  
        "## $$koi2_title_TrafficSign",
        {
            opcode: 'koiv3TrafficSignCoord',
            blockType: "reporter",
