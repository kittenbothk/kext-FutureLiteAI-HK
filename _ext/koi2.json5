{
    id: "futureboardLite_koiv4",
    name: "$$koi2",
    color1: "#fc6e00",
    color2: "#df6100",
    color3: "#cc621b",
    image: "./_img/koi-2.png",
    description: "$$koi2_description",
    tutorial_url: "https://www.yuque.com/kittenbot/hardwares/koi2",
    tags: ['module'],
    libs:{
        "*":{
            import: 'from koi2 import KOI2',
        }
    },   

    blocks: 
    [
        {
            opcode: 'koiv3RunInit',
            blockType: "command",
            text: "$$koi2_KOIRunInit",
            pycode: "koi = KOI2([UARTPOART])",
            arguments:{
                UARTPOART:{
                    type: "string",
                    defaultValue: 'uart0', 
                    menu: 'uartPort'
                },
            }
        },
        {
            opcode: 'koiv3SetModel',
            blockType: "command",
            text: "$$koi2_KOISetModel",
            pycode: "koi.setModel([MODEL])",
            arguments:{
                MODEL:{
                    type: "number",
                    defaultValue: 0x0, 
                    menu: 'model'
                },
            }
        },
        {
            opcode: 'koiv3KOIUpdateData',
            blockType: "command",
            text: "$$koi2_KOIUpdateData",
            pycode: "koi.read_from_uart()",
        },

        "---",
        "## $$koi2_title_basic",
        {
            opcode: 'koiv3GetJpgBuf',
            blockType: "reporter",
            text: "$$koi2_GetJpgBuf",
            pycode: "koi.getJpgBuf(display=[DISPLAY])",
            arguments:{
                DISPLAY:{
                    type: "number",
                    defaultValue: 0,
                    menu: 'jpgBufDisplay'
                },
            }
        },
        {
            opcode: 'koiv3SensorDir',
            blockType: "command",
            text: "$$koi2_KOISensorDir",
            pycode: "koi.direction([DIR])",
            arguments:{
                DIR:{
                    type: "number",
                    defaultValue: '2', 
                    menu: 'dir'
                },
            }
        },
        {
            opcode: 'koiv3SensorMirror',
            blockType: "command",
            text: "$$koi2_KOISensorMirror",
            pycode: "koi.mirror([ENABLED])",
            arguments:{
                ENABLED:{
                    type: "number",
                    defaultValue: '1', 
                    menu: 'switch'
                },
            }
        },
        "---",
        {
            opcode: 'koiv3ButtonState',
            blockType: "Boolean",
            text: "$$koi2_KOIBtenState",
            pycode: "koi.getBtnState([BTN])",
            arguments:{
                BTN:{
                    type: "string",
                    defaultValue: 'A', 
                    menu: 'BTNLIST'
                },
            }
        },
        {
            opcode: 'koiv3Record',
            blockType: "command",
            text: "$$koi2_KOIRecord",
            pycode: "koi.recorded('/sd/'+[FILE],[SEC])",
            arguments:{
                FILE:{
                    type: "string",
                    defaultValue: 'abc.wav'
                },
                SEC:{
                    type: "number",
                    defaultValue: '3'
                }

            }
        },
        {
            opcode: 'koiv3PlayAudio',
            blockType: "command",
            text: "$$koi2_KOIPlayAudio",
            pycode: "koi.playAudio('/sd/'+[FILE])",
            arguments:{
                FILE:{
                    type: "string",
                    defaultValue: 'abc.wav'
                },
            }
        },
        {
            opcode: 'koiv3KOITakePic',
            blockType: "command",
            text: "$$koi2_KOITakePic",
            pycode: "koi.takePic([DIR]+[PATH])",
            arguments:{
                DIR:{
                    type: "string",
                    menu: "svaePath",
                    defaultValue: "/sd/"
                },
                PATH:{
                    type: "string",
                    defaultValue: 'abc.jpg'
                },
            }
        },
        {
            opcode: 'koiv3KOIDisplayPic',
            blockType: "command",
            text: "$$koi2_KOIDisplayPic",
            pycode: "koi.displayPic([DIR]+[PATH],[SEC]*1000)",
            arguments:{
                DIR:{
                    type: "string",
                    menu: "svaePath",
                    defaultValue: "/sd/"
                },
                PATH:{
                    type: "string",
                    defaultValue: 'abc.jpg'
                },
                SEC:{
                    type: "number",
                    defaultValue: '3',
                }
            }
        },
        {
            opcode: 'koiv3KOIDisplayText',
            blockType: "command",
            text: "$$koi2_KOIDisplayText",
            pycode: "koi.displayText([X]+40,[Y],[DELAY]*1000,[COLOUR],[TEXT])",
            arguments:{
                X:{
                    type: "number",
                    defaultValue: '0',
                },
                Y:{
                    type: "number",
                    defaultValue: '0',
                },
                DELAY:{
                    type: "number",
                    defaultValue: '3',
                },
                COLOUR:{
                    type: "colorrgb",
                },
                TEXT:{
                    type: "string",
                    defaultValue: 'hello',
                }
            }
        },
        "---",
        {
            opcode: 'koiv3KOIDisplayFileList',
            blockType: "command",
            text: "$$koi2_KOIDisplayFileList",
            pycode: "koi.displayFileList([ADDR],[PAGE])",
            arguments:{
                ADDR:{
                    type: "string",
                    menu: "fileAddress",
                    defaultValue: "/sd"
                },
                PAGE:{
                    type: "number",
                    defaultValue: 1
                }
            }
        },
        {
            opcode: 'koiv3KOICloseFileList',
            blockType: "command",
            text: "$$koi2_KOICloseFileList",
            pycode: "koi.closeFileList()"
        },
        {
            opcode: 'koiv3KOIDeleteFile',
            blockType: "command",
            text: "$$koi2_KOIDeleteFile",
            pycode: "koi.deleteFile([PATH])",
            arguments:{
                PATH:{
                    type: "string",
                    defaultValue: "/sd/test.txt"
                }
            }
        },
        {
            opcode: 'koiv3KOICopyFile',
            blockType: "command",
            text: "$$koi2_KOICopyFile",
            pycode: "koi.copyFile([SRC_PATH],[DST_PATH])",
            arguments:{
                SRC_PATH:{
                    type: "string",
                    defaultValue: "/sd/test.txt"
                },
                DST_PATH:{
                    type: "string",
                    defaultValue: "/flash/test.txt"
                }
            }
        },
        "---",   
        "## $$koi2_title_ColorBlob",
        {
            opcode: 'koiv3ColorBlobSetColor',
            blockType: "command",
            text: "$$koi2_ColorBlobSetColor",
            pycode: "koi.colorSwitch([HUE])",
            arguments:{
                HUE:{
                    type: "number",
                    defaultValue: '0',
                    menu: 'ColorBlobMenu'
                },
            }
        },
        {
            opcode: 'koiv3ColorBlobCalibrate',
            blockType: "command",
            text: "$$koi2_ColorBlobCalibrate",
            pycode: "koi.colorCalibration()"
        },
        {
            opcode: 'koiv3ColorBlobCoord',
            blockType: "reporter",
            text: "$$koi2_ColorBlobCoord",
            pycode: "koi.xywh[[XYWH]]",
            arguments:{
                XYWH:{
                    type: "number",
                    defaultValue: 0, 
                    menu: 'coord'
                },
            }
        },
        "---",  
        "## $$koi2_title_line",
        {
            opcode: 'koiv3lineSetColor',
            blockType: "command",
            text: "$$koi2_lineSetColor",
            pycode: "koi.lineSwitch([HUE])",
            arguments:{
                HUE:{
                    type: "number",
                    defaultValue: '0',
                    menu: 'lineMenu'
                },
            }
        },
        {
            opcode: 'koiv3lineCalibrate',
            blockType: "command",
            text: "$$koi2_lineCalibrate",
            pycode: "koi.colorCalibration()"
        },
        {
            opcode: 'koiv3lineCoord',
            blockType: "reporter",
            text: "$$koi2_lineCoord",
            pycode: "koi.xy12[[XY12]]",
            arguments:{
                XY12:{
                    type: "number",
                    defaultValue: 0, 
                    menu: 'coord12'
                },
            }
        },
