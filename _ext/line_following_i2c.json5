            blockType: "command",
            text: "$$lineFollowingI2C_readConfidence",
            pycode: 'lfi2c.readConfidence()'
        },
        {
            opcode: 'readADC',
            blockType: "command",
            text: "$$lineFollowingI2C_readADC",
            pycode: 'lfi2c.readADC()'
        },
        {
            opcode: 'getStatus',
            blockType: "Boolean",
            text: "$$lineFollowingI2C_getStatus",
            pycode: 'lfi2c.getStatus([INDEX]) == [STATUS]',
            arguments:{
                INDEX :{
                    type: "number",
                    defaultValue: 0, 
                    menu: "SENSOR_INDEX"
                },
                STATUS :{
                    type: "number",
                    defaultValue: 1, 
                    menu: "SENDOR_STATUS"
                }
            }
        },
        {
            opcode: 'getConfidence',
            blockType: "reporter",
            text: "$$lineFollowingI2C_getConfidence",
            pycode: 'lfi2c.getConfidence([INDEX])',
            arguments:{
                INDEX :{
                    type: "number",
                    defaultValue: 0, 
                    menu: "SENSOR_INDEX"
                },
            }
        },
        {
            opcode: 'getADC',
            blockType: "reporter",
            text: "$$lineFollowingI2C_getADC",
            pycode: 'lfi2c.getADC([INDEX])',
            arguments:{
                INDEX :{
                    type: "number",
                    defaultValue: 0, 
                    menu: "SENSOR_INDEX"
                },
            }
        },
        '---',
        {
            opcode: 'getADCCalibration',
            blockType: "reporter",
            text: "$$lineFollowingI2C_getADCCalibration",
            pycode: 'lfi2c.readADCCalibration()[[INDEX]]',
            arguments:{
                INDEX :{
                    type: "number",
                    defaultValue: 0, 
                    menu: "SENSOR_INDEX"
                },
            }
        },
    ],
    menus: {
        SENSOR_INDEX:[
