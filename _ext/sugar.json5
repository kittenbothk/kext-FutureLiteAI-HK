    // '---',

    "## $$sugar_title_analog", 
//-----------------------------------------------------------------
    // "## $$sugar_frame",
    {
      opcode: 'getFrameStatus',
      blockType: 'Boolean',
      text: "$$sugar_getFrameStatus",
      pycode: 'flame_p[PORT].value() > 100',
      arguments: {
        PORT: {
          type: "value",
          defaultValue: 1,
          menu: 'PINS_ANALOG_READ',
        }
      }
    },
    {
      opcode: 'getFrameValue',
      blockType: "reporter",
      text: "$$sugar_getFrameValue",
      pycode: 'flame_p[PORT].value()',
      arguments: {
        PORT: {
          type: "value",
          defaultValue: 1,
          menu: 'PINS_ANALOG_READ',
        }
      }
    },
    '---',
//-----------------------------------------------------------------
    // "## $$sugar_rotation",
    {
      opcode: 'getRotationValue',
      blockType: "reporter",
