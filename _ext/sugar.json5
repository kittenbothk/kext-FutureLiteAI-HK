{
  id: "futureboard-lite_sugar",
  name: "$$sugar",
  color1: "#30caf9",
  color2: "#1cb1e5",
  color3: "#2daae0",
  tags: ['module','sensor','actuator','display'],
  image: "_img/sugar.png",
  description: "$$sugar_description",
  tutorial_url: "https://www.yuque.com/kittenbot/hardwares/sugar",
  libs: {
    "*": {
      import: 'from sugar import *'
    },
    "sugarColor3":{
        import: "from sugar_color import *",
        instance: "SugarColor(address=0x39)"
    },
    "pir_p[PORT]": {
      instance: "PIR('P[PORT]')"
    },
    "tracker_p[PORT]": {
      instance: "Tracker('P[PORT]')"
    },
    "hall_p[PORT]": {
      instance: "Hall('P[PORT]')"
    },
    "button_p[PORT]": {
      instance: "Button('P[PORT]')"
    },
    "flame_p[PORT]": {
      instance: "Flame('P[PORT]')"
    },
    "angle_p[PORT]": {
      instance: "Angle('P[PORT]')"
    },
    "grayscale_p[PORT]": {
      instance: "Grayscale('P[PORT]')"
    },
    "light_p[PORT]": {
      instance: "Light('P[PORT]')"
    },
    "soil_p[PORT]": {
      instance: "Soil('P[PORT]')"
    },
    "waterLever_p[PORT]": {
      instance: "WaterLevel('P[PORT]')"
    },
    "led_p[PORT]": {
      instance: "LED('P[PORT]')"
    },
    "buzzerA_p[PORT]": {
      instance: "BuzzerA('P[PORT]')"
    },
    "vibrate_p[PORT]": {
      instance: "Vibrate('P[PORT]')"
    },
    "laser_p[PORT]": {
      instance: "Laser('P[PORT]')"
    },
    "tofDis": {
      instance: "TOFDistance()"
    },
    "env1": {
      instance: "ENV()"
    },
    "env2": {
      instance: "ENV2()"
    },
    "joystick": {
      instance: "Joystick()"
    },
    "infra_p[PORT]": {
      instance: "InfraRx('P[PORT]')"
    },
    "ds[PORT]":{
      instance: "UDS18X20('P[PORT]')"
    },
    "display":{
      instance:"Nixietube()"
    },
   "rfids":{
      import: "from rfid import *",
      instance: "RFID()"
    }, 
    "crash_p[PORT]": {
      instance: "Crash('P[PORT]')"
    },
    "touch_p[PORT]": {
      instance: "Touch('P[PORT]')"
    },
    "touch_p[PORT]": {
      instance: "Touch('P[PORT]')"
    },
    "sound_p[PORT]": {
      instance: "Sound('P[PORT]')"
    },
    "ledStrand_p[PORT]": {
      instance: "LED('P[PORT]')"
    },
    "fogging_p[PORT]": {
      instance: "Fogging('P[PORT]')"
    },
    "pm":{
        import: "from pmsa003i import *",
        instance: "PMSA003I()"
    },
  },


  blocks:[
    "## $$sugar_title_digital",
    // "## $$sugar_human",
    {
      opcode: 'getHumandetectStatus',
      blockType: 'Boolean',
      text: "$$sugar_getHumandetectStatus",
      pycode: 'pir_p[PORT].value()',
      arguments: {
        PORT: { 
          type: "value",
          defaultValue: 1,
          menu: 'PIN_DIG_READ',
        }
      }
    },
    '---',
  //-----------------------------------------------------------------
    // "## $$sugar_trace",
    {
      opcode: 'getTrackStatus',
      blockType: 'Boolean',
      text: "$$sugar_getTractStatus",
      pycode: 'tracker_p[PORT].value() == [TYPE]',
      arguments: {
        PORT: {
          type: "value",
          defaultValue: 1,
          menu: 'PIN_DIG_READ',
        },
        TYPE: {
          type: "string",
          defaultValue: '0',
          menu: 'TRACK_STATE',
        }
      }
    },
    '---',
//-----------------------------------------------------------------
    // "## $$sugar_hall",
    {
      opcode: 'getHallStatus',
      blockType: 'Boolean',
      text: "$$sugar_getHallStatus",
      pycode: 'hall_p[PORT].value() == 0',
      arguments: {
        PORT: {
          type: "value",
          defaultValue: 1,
          menu: 'PIN_DIG_READ',
        }
      }
    },
    '---',
//-----------------------------------------------------------------
    // "## $$sugar_btn",
    {
      opcode: 'getButtonStatus',
      blockType: 'Boolean',
      text: "$$sugar_getButtonStatus",
      pycode: 'button_p[PORT].value() == 0',
      arguments: {
        PORT: {
          type: "value",
          defaultValue: 1,
          menu: 'PIN_DIG_READ',
        }
      }
    },
    '---',
    {
      opcode: 'getCrashStatus',
      blockType: 'Boolean',
      text: "$$sugar_getCrashStatus",
      pycode: 'crash_p[PORT].value() == 1',
      arguments: {
        PORT: {
          type: "value",
          defaultValue: 1,
          menu: 'PIN_DIG_READ',
        }
      }
    },
    '---',
//-----------------------------------------------------------------
    // "## $$sugar_infra"
    {
      opcode: 'infraRequest',
      blockType: 'reporter',
      text: "$$sugar_infraRequest",
      pycode: 'infra_p[PORT].getInfraRxData()',      
      arguments: {
        PORT: {
          type: "value",
          defaultValue: 1,
          menu: 'PIN_DIG_READ',
        }
      }
    },
    '---',
    {
      opcode: 'getTouchStatus',
      blockType: 'Boolean',
      text: "$$sugar_getTouchStatus",
      pycode: 'touch_p[PORT].value() == 1',
      arguments: {
        PORT: {
          type: "value",
          defaultValue: 1,
          menu: 'PIN_DIG_READ',
        }
      }
    },
    '---',
//-----------------------------------------------------------------
    // "## $$sugar_temp",
    // {
    //   opcode: 'getTempValue',
