    '---',
    {
      opcode: 'getGrayscaleValue',
      blockType: "reporter",
      text: "$$sugar_getGrayscaleValue",
      pycode: 'grayscale_p[PORT].value()',
      arguments: {
        PORT: {
          type: "value",
          defaultValue: 1,
          menu: 'PINS_ANALOG_READ',
        }
      }
    },
    '---',
//-----------------------------------------------------------------
    // "## $$sugar_light",
    {
      opcode: 'getLightValue',
      blockType: "reporter",
      text: "$$sugar_getLightValue",
      pycode: 'light_p[PORT].value()',
      arguments: {
        PORT: {
          type: "value",
          defaultValue: 1,
          menu: 'PINS_ANALOG_READ',
        }
      }
    },
    '---',
//-----------------------------------------------------------------
    // "## $$sugar_moisture",
    {
      opcode: 'getMoistureValue',
      blockType: "reporter",
      text: "$$sugar_getMoistureValue",
      pycode: 'soil_p[PORT].value()',
      arguments: {
        PORT: {
          type: "value",
          defaultValue: 1,
          menu: 'PINS_ANALOG_READ',
        }
      }
    },
    '---',
//-----------------------------------------------------------------
    // "## $$sugar_waterlevel",
    {
      opcode: 'getWaterLevelValue',
      blockType: "reporter",
      text: "$$sugar_getWaterLevelValue",
      pycode: 'waterLever_p[PORT].value()',
      arguments: {
        PORT: {
          type: "value",
          defaultValue: 1,
          menu: 'PINS_ANALOG_READ',
        }
      }
    },
    '---',
    {
      opcode: 'getSoundValue',
      blockType: "reporter",
      text: "$$sugar_getSoundValue",
      pycode: 'sound_p[PORT].value()',
      arguments: {
        PORT: {
          type: "value",
          defaultValue: 1,
          menu: 'PINS_ANALOG_READ',
        }
      }
    },
    '---',
    {
      opcode: 'getDs18x20lValue',
      blockType: "reporter",
      text: "$$sugar_getDs18x20lValue",
      pycode: 'ds[PORT].temperature',
      arguments: {
        PORT: {
          type: "value",
          defaultValue: 1,
          menu: 'PINS_ANALOG_READ',
        }
      }
    },
    '---',

    "## $$sugar_title_i2c",
//-----------------------------------------------------------------
    // "## $$sugar_lazer",
    {
      opcode: 'getDistanceValue',
      blockType: "reporter",
      text: "$$sugar_getDistanceValue",
      pycode: 'tofDis.value()',
      disableMonitor: 1,
    },
    '---',
    {
        opcode: 'updateColor',
        blockType: "command",
        text: "$$sugarColor_updateColor",
        pycode: 'sugarColor3.update()'
    },
    {
        opcode: 'getColorRGB',
        blockType: "reporter",
        text: "$$sugarColor_getColorRGB",
        pycode: 'sugarColor3.[COLORTYPE]',
        arguments:{
            COLORTYPE :{
                type: "value",
                defaultValue: 'red', 
                menu: "RGBCOLOR"
            },
        }
    },
    {
        opcode: 'getHue',
        blockType: "reporter",
        text: "$$sugarColor_getHue",
        pycode: 'sugarColor3.hue'
    },
    {
        opcode: 'getColorLM',
        blockType: "reporter",
        text: "$$sugarColor_getColorLM",
        pycode: 'sugarColor3.lm',
    },
    '---',
//-----------------------------------------------------------------
    // "## $$sugar_tmphum",
    {
      opcode: 'getTmpValue',
      blockType: "reporter",
      text: "$$sugar_getTmpValue",
      pycode: 'env1.update()[[TYPE]]',
      arguments: {
        TYPE: {
          type: "number",
          defaultValue: 1,
          menu: 'MOISTURETYPE'
        }
      }
    },
    '---',
//-----------------------------------------------------------------
    {
      opcode: 'getENV2Pressure',
      blockType: "reporter",
      text: "$$sugar_getENV2Pressure",
      pycode: 'env2.read_pres()'
    },
//-----------------------------------------------------------------
    {
      opcode: 'getENV2Altitude',
      blockType: "reporter",
      text: "$$sugar_getENV2Altitude",
      pycode: 'env2.read_altitude()'
    },
//-----------------------------------------------------------------
    {
      opcode: 'getENV2Temp',
      blockType: "reporter",
      text: "$$sugar_getENV2Temp",
      pycode: 'env2.read_temp()[[TYPE]]',
      arguments: {
        TYPE: {
          type: "number",
          defaultValue: 1,
          menu: 'ENV2_TEMP_TYPE'
        }
      }
    },
    '---',
//-----------------------------------------------------------------
    // "## $$sugar_joystick",
    {
      opcode: 'getJoyStickStatus',
      blockType: "Boolean",
      text: "$$sugar_getJoyStickStatus",
      pycode: 'joystick.state() == [STATE]',
      arguments: {
        STATE: {
          type: "string",
          defaultValue: 'up',
          menu: 'JOYSTICK_DIR'
        }
      }
    },
    {
      opcode: 'getJoyStickValue',
      blockType: "reporter",
      text: "$$sugar_getJoyStickValue",
      pycode: 'joystick.value([TYPE])',
      arguments: {
        TYPE: {
          type: "string",
          defaultValue: 'x',
          menu: 'JOYSTICK_XY'
        }
      }
    },
    '---',
    {
        opcode: 'sugarPM',
        blockType: "reporter",
        text: "$$sugarPM_getvalue",
        pycode: 'pm.read()[[LX]]',
        arguments: {
            LX: {
            type: "value",
            defaultValue: '1',
            menu: "PMTYPE"
            }
        }
    },
    '---',
    "## $$sugar_title_actuator", 
//-----------------------------------------------------------------
    {
      opcode: 'vibrateState',
      blockType: 'command',
      text: "$$sugar_vibrateState",
      pycode: 'vibrate_p[PORT].state([STATE])',
      arguments: {
        PORT: {
          type: "value",
          defaultValue: 1,
          menu: 'PIN_DIG_WRITE',
        },
        STATE: {
          type: "number",
          defaultValue: 1,
          menu: 'DIGI_STATE',
        }
      }
    },
    '---',
//-----------------------------------------------------------------
    {
      opcode: 'buzzerAState',
      blockType: 'command',
      text: "$$sugar_buzzerAState",
      pycode: 'buzzerA_p[PORT].state([STATE])',
      arguments: {
        PORT: {
          type: "value",
          defaultValue: 1,
          menu: 'PIN_DIG_WRITE',
        },
        STATE: {
          type: "number",
          defaultValue: 1,
          menu: 'DIGI_STATE',
        }
      }
    },
    {
      opcode: 'foggingState',
      blockType: "command",
      text: "$$sugar_fogging",
      pycode: 'fogging_p[PORT].state([STATE])',
      arguments:{
        PORT: {
          type: "value",
          defaultValue: 1,
          menu: 'PINS_ANALOG_WRITE',
        },
        STATE: {
          type: "string",
          defaultValue: 1,
          menu: 'COLON_STATE',
        },
      }
    }, 
//-----------------------------------------------------------------
    {
      opcode: 'laserState',
      blockType: 'command',
      text: "$$sugar_laserState",
      pycode: 'laser_p[PORT].state([STATE])',
      arguments: {
        PORT: {
          type: "value",
          defaultValue: 1,
          menu: 'PIN_DIG_WRITE',
        },
        STATE: {
          type: "number",
          defaultValue: 1,
          menu: 'DIGI_STATE',
        }
      }
    },
    '---',

    "## $$sugar_title_display", 
//-----------------------------------------------------------------
    // "## $$sugar_led",
    {
      opcode: 'ledToggle',
      blockType: "command",
      text: "$$sugar_ledToggle",
      pycode: 'led_p[PORT].state([STATE])',
      arguments:{
        PORT: {
          type: "value",
          defaultValue: 1,
          menu: 'PIN_DIG_WRITE',
        },
        STATE: {
          type: "string",
          defaultValue: 'ON',
          menu: 'LEDSTATE',
        },
      }
    },
    {
      opcode: 'ledBrightness',
      blockType: "command",
      text: "$$sugar_ledBrightness",
      pycode: 'led_p[PORT].brightness([BRIGHTNESS])',
      arguments: {
        PORT: {
          type: "value",
          defaultValue: 1,
          menu: 'PINS_ANALOG_WRITE',
        },
        BRIGHTNESS: {
          type: "slider",
          defaultValue: 1,
          max: 100,
          min: 0,
        }
      },
    },
    {
      opcode: 'ledStrandToggle',
      blockType: "command",
      text: "$$sugar_ledStrandToggle",
      pycode: 'ledStrand_p[PORT].state([STATE])',
      arguments:{
        PORT: {
          type: "value",
          defaultValue: 1,
          menu: 'PIN_DIG_WRITE',
        },
        STATE: {
          type: "string",
          defaultValue: 'ON',
          menu: 'LEDSTATE',
        },
      }
    },
    {
      opcode: 'ledStrandBrightness',
      blockType: "command",
      text: "$$sugar_ledStrandBrightness",
      pycode: 'ledStrand_p[PORT].brightness([BRIGHTNESS])',
      arguments: {
        PORT: {
          type: "value",
          defaultValue: 1,
          menu: 'PINS_ANALOG_WRITE',
        },
        BRIGHTNESS: {
          type: "slider",
          defaultValue: 1,
          max: 100,
          min: 0,
        }
      },
    },
    '---',
//------------------------------------------------------
    {
      opcode: 'tm1650ShowNumber',
      blockType: "command",
      text: "$$sugar_tm1650ShowNumber",
      pycode: 'display.shownum([NUM])',
      arguments: {
        NUM: {
          type: "number",
          defaultValue: 1234
        }
      }
    },
//------------------------------------------------------
    {
      opcode: 'tm1650ShowBit',
      blockType: "command",
      text: "$$sugar_tm1650ShowBit",
      pycode: 'display.showbit([NUM],[POS]-1)',
      arguments: {
        NUM: {
          type: "slider",
          defaultValue: 1,
          max: 15,
          min: 0, 
        },
        POS: {
          type: "slider",
          defaultValue: 1,
          max: 4,
          min: 1, 
        }
      }
    },
//------------------------------------------------------
    {
      opcode: 'tm1650ShowBar',
      blockType: "command",
      text: "$$sugar_tm1650ShowBar",
      pycode: 'display.showbit("-",[POS]-1)',
      arguments: {
        POS: {
          type: "slider",
          defaultValue: 1,
          max: 4,
          min: 1, 
        }
      }
    },
//------------------------------------------------------
    {
      opcode: 'tm1650ShowColon',
      blockType: "command",
      text: "$$sugar_tm1650ShowColon",
      pycode: 'display.showDP(1,[STATE])',
      arguments: {
        STATE: {
          type: "number",
          defaultValue: 1,
          menu: 'COLON_STATE',
        },
      }
    },
//------------------------------------------------------
    {
      opcode: 'tm1650ShowDP',
      blockType: "command",
      text: "$$sugar_tm1650ShowDP",
      pycode: 'display.showDP([POS]-1,[STATE])',
      arguments: {
        POS: {
          type: "slider",
          defaultValue: 2,
          max: 4,
          min: 2, 
        },
        STATE: {
          type: "number",
          defaultValue: 1,
          menu: 'COLON_STATE',
        },
      }
    },
//------------------------------------------------------
    {
      opcode: 'tm1650Intensity',
      blockType: "command",
      text: "$$sugar_tm1650Intensity",
      pycode: 'display.intensity([VALUE])',
      arguments: {
        VALUE: {
          type: "slider",
          defaultValue: 8,
          max: 8,
          min: 0, 
        }
      }
    },
//------------------------------------------------------
    {
      opcode: 'tm1650DisplaySta',
      blockType: "command",
      text: "$$sugar_tm1650DisSta",
      pycode: "display.[STA]()",
      arguments: {
        STA: {
          type: "value",
          defaultValue: 'clear',
          menu: "DISPLAY_STATE"
        }
      }
    },
    '---',
    "## $$sugar_title_rfid",
    {
      opcode: 'scanRfid',
      blockType: "boolean",
      text: "$$sugar_scanRfid",
      pycode: "rfids.scan()[0] == 0",
    },
    {
      opcode: 'scanRfid',
      blockType: "boolean",
      text: "$$sugar_scanRfid",
      pycode: "rfids.scan()[0] == 0",
      hide : true      
    },
    {
      opcode: 'getRfidUid',
      blockType: "reporter",
      text: "$$sugar_getRfidUid",
      pycode: "rfids.uuid()",
    },
    {
      opcode: 'RfidWrite',
      blockType: "command",
      text: "$$sugar_RfidWrite",
      pycode: 'rfids.write([ADDR],[DATA])',
      arguments: {
        ADDR: {
          type: "slider",
          defaultValue: 0,
          min:0,
          max:46
        },
        DATA: {
          type: "string",
          defaultValue: 'hello kittenbot'
        }
      }
    },
    {
      opcode: 'RfidRead',
      blockType: "reporter",
      text: "$$sugar_RfidRead",
      pycode: 'rfids.read([ADDR])',
      arguments: {
        ADDR: {
          type: "slider",
          defaultValue: 0,
          min:0,
          max:46
        }
      }
    },
    '---',
  ],
