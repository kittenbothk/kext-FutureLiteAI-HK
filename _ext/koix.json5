{
  id: "futureboard-lite_koix",
  name: "$$koix_name",
  color1: "#4C525B",
  color2: "#373D45",
  color3: "#22262B",
  image: "_img/koix.png",
  description: "$$koix_description",
  tags: ["module"],
  libs: {
    "*": {
      import: "from koix import KOIX"
    }
  },
  blocks: [
    "## $$koix_title_general",
    {
      opcode: "koixInit",
      blockType: "command",
      text: "$$koix_init",
      pycode: "koix = KOIX.open([PORT])",
      arguments: {
        PORT: {
          type: "string",
          defaultValue: "uart0",
          menu: "uartPort"
        }
      }
    },
    {
      opcode: "koixSwitchModel",
      blockType: "command",
      text: "$$koix_switch_model",
      pycode: "koix.app_switch([MODEL])",
      arguments: {
        MODEL: {
          type: "string",
          defaultValue: "face",
          menu: "apps"
        }
      }
    },
    {
      opcode: "koixCapture",
      blockType: "command",
      text: "$$koix_capture",
      pycode: "koix.capture([FILE])",
      arguments: {
        FILE: {
          type: "string",
          defaultValue: "photo.jpg"
        }
      }
    },
    {
      opcode: "koixError",
      blockType: "reporter",
      text: "$$koix_error",
      pycode: "koix.error()"
    },
    "---",
    "## $$koix_face_title",
    {
      opcode: "koixFaceRequest",
      blockType: "command",
      text: "$$koix_face_request",
      pycode: "koix.request('FACE')"
    },
    {
      opcode: "koixFaceDetected",
      blockType: "Boolean",
      text: "$$koix_face_detected",
      pycode: "koix.detected('FACE')"
    },
    {
      opcode: "koixFaceCenter",
      blockType: "Boolean",
      text: "$$koix_face_center",
      pycode: "koix.center_detected('FACE')"
    },
    {
      opcode: "koixFaceNearest",
      blockType: "reporter",
      text: "$$koix_face_nearest",
      pycode: "koix.nearest('FACE', [FIELD])",
      arguments: {
        FIELD: {
          type: "string",
          defaultValue: "id",
          menu: "faceFields"
        }
      }
    },
    {
      opcode: "koixFaceCount",
      blockType: "reporter",
      text: "$$koix_face_count",
      pycode: "koix.count('FACE')"
    },
    {
      opcode: "koixFaceValue",
      blockType: "reporter",
      text: "$$koix_face_value",
      pycode: "koix.value('FACE', [INDEX], [FIELD])",
      arguments: {
        INDEX: {
          type: "number",
          defaultValue: 1
        },
        FIELD: {
          type: "string",
          defaultValue: "id",
          menu: "faceFields"
        }
      }
    },
    {
      opcode: "koixFaceIdExists",
      blockType: "Boolean",
      text: "$$koix_face_id_exists",
      pycode: "koix.id_exists('FACE', [ID])",
      arguments: {
        ID: {
          type: "number",
          defaultValue: 1
        }
      }
    },
    {
      opcode: "koixFaceIdCount",
      blockType: "reporter",
      text: "$$koix_face_id_count",
      pycode: "koix.id_count('FACE', [ID])",
      arguments: {
        ID: {
          type: "number",
          defaultValue: 1
        }
      }
    },
    {
      opcode: "koixFaceIdValue",
      blockType: "reporter",
      text: "$$koix_face_id_value",
      pycode: "koix.id_value('FACE', [ID], 1, [FIELD])",
      arguments: {
        ID: {
          type: "number",
          defaultValue: 1
        },
        FIELD: {
          type: "string",
          defaultValue: "name",
          menu: "faceFields"
        }
      }
    },
    {
      opcode: "koixFaceIdIndexValue",
      blockType: "reporter",
      text: "$$koix_face_id_index_value",
      pycode: "koix.id_value('FACE', [ID], [INDEX], [FIELD])",
      arguments: {
        ID: {
          type: "number",
          defaultValue: 1
        },
        INDEX: {
          type: "number",
          defaultValue: 1
        },
        FIELD: {
          type: "string",
          defaultValue: "name",
          menu: "faceFields"
        }
      }
    },
    {
      opcode: "koixFaceLearn",
      blockType: "command",
      text: "$$koix_face_learn_text",
      pycode: "koix.learn('FACE', [ID], [LABEL])",
      arguments: {
        ID: {
          type: "number",
          defaultValue: 1
        },
        LABEL: {
          type: "string",
          defaultValue: "lily"
        }
      }
    },
    {
      opcode: "koixFaceRename",
      blockType: "command",
      text: "$$koix_face_rename_text",
      pycode: "koix.rename('FACE', [ID], [LABEL])",
      arguments: {
        ID: {
          type: "number",
          defaultValue: 1
