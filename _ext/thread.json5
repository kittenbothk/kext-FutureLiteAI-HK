        { 
            opcode: "threadExtend",
            blockType: "hat",
            text: "$$thread_threadId",
            pycode: [
                "_thread.start_new_thread(thread[THREADID], ())",
                "def thread[THREADID]()"
            ],
            arguments:{
                THREADID:{
                    type: "value",
                    defaultValue: 1, 
                    menu: 'threadLine',
                }
            }
        },        
    ],    
    menus:{
        threadLine:['1','2','3','4','5']
   }    
