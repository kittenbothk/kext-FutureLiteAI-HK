{
    id: "futureboard-lite_thread",
    name: "$$thread",
    color1: "#30caf9",
    color2: "#1cb1e5",
    color3: "#2daae0",
    image: "_img/thread.png",
    description: "$$thread_description",
    tags: ['advanced'],
    libs:{
        "*": {
            import: 'import _thread'
        },
    },
    blocks: 
    [
