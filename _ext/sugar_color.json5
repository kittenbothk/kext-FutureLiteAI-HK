{
    id: "futureboardLite_sugarColor",
    name: "$$sugarColor",
    color1: "#388EE5",
    color2: "#2771BC",
    color3: "#1C5FA2",
    image: "_img/sugarColor.png",
    tutorial_url: "https://www.yuque.com/kittenbot/hardwares/sugar-color",
    description: "$$sugarColor_description",
    tags: ['module'],
    libs:{
        "sugarColor":{
            import: "from sugar_color import *",
            instance: "SugarColor()"
        },
    },
    blocks: 
    [
        {
            opcode: 'updateColor',
            blockType: "command",
            text: "$$sugarColor_updateColor",
            pycode: 'sugarColor.update()'
        },
        {
            opcode: 'getColorRGB',
            blockType: "reporter",
            text: "$$sugarColor_getColorRGB",
            pycode: 'sugarColor.[COLORTYPE]',
            arguments:{
                COLORTYPE :{
                    type: "value",
                    defaultValue: 'red', 
                    menu: "RGBCOLOR"
                },
            }
        },
        {
            opcode: 'getHue',
            blockType: "reporter",
            text: "$$sugarColor_getHue",
            pycode: 'sugarColor.hue'
        },
        {
            opcode: 'getColorLM',
            blockType: "reporter",
            text: "$$sugarColor_getColorLM",
            pycode: 'sugarColor.lm',
        },
    ],
    menus: {
        RGBCOLOR:[
            { text: '$$sugarColor_menu_red', value: 'red'},
            { text: '$$sugarColor_menu_green', value: 'green'},
            { text: '$$sugarColor_menu_blue', value: 'blue'},
        ]
    }
}