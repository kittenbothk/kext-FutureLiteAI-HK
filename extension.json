    "filesystem": "pyboard",
    "disk": "kitten",
    "masterExt": "futureboard-lite-mpy",
    "libspath": "lib",
    "listdevice": {
        "vid": 12346
    },
    "tags": [
        "hardware"
    ],
    "afterConnect": [
        "from future import *",
        "screens = Screen()",
        "screens.init()",
        "time.sleep(0.3)",
        "screens.clear()",
        "screens.text('Hello Future',32,60,1,(71,233,0))",
        "screens.refresh()"
    ],
    "io": [
        "serial",
        "tcp",
        "ble"
    ],
    "ble": {
        "boardcast": "0x6e40",
        "service": "6E400001-B5A3-F393-E0A9-E50E24DCCA9E",
        "txChar": "6E400003-B5A3-F393-E0A9-E50E24DCCA9E",
        "rxChar": "6E400002-B5A3-F393-E0A9-E50E24DCCA9E"
    },
    "connect": {
        "no_reset": 1,
        "wait": 5000
    },
    "file": "kblock.json5",
    "subextensions": [
        "_ext/sugar.json5",
        "_ext/sugar_asr.json5",
