{
    "name": {
        "en": "Future LiteAI HK",
        "zh-cn": "Future LiteAI HK",
        "zh-tw": "Future LiteAI HK"
    },
    "id": "futureboard-lite-mpy",
    "version": "2.5.0",
    "type": "micropy",
    "fwtype": "uf2",
    "replmode": true,
    "execmode": true,
    "kittenext": true,
    "buildinpyb": true,
    "l10n": "futureboard-lite-mpy.l10n.json",
    "color1": "#0099FF",
    "color2": "#0080ff",
    "color3": "#0a7aea",
